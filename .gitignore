# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Env / secrets
# Matches at any depth, so frontend/.env is covered too. The trailing wildcard
# catches Vite's per-mode files (.env.local, .env.production, ...); the
# negation keeps the committed template.
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Node / frontend
node_modules/
dist/
build/
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime output
*.log
results/
