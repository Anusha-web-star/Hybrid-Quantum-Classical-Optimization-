# Copy to .env and fill in. .env is git-ignored.

# --- Backend ---
APP_NAME=Hybrid Quantum-Classical Energy TSP
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# --- Dataset ---
# Path to the transmission line CSV, relative to the project root.
DATA_DIR=data
TRANSMISSION_LINES_CSV=transmission_lines.csv

# --- Database (Phase 8) ---
# Not wired up: app/core/config.py declares neither of these and ignores extra
# variables, so setting them today has no effect. Kept as the plan of record.
# SQLite is fine for development.
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/energy_tsp

# --- Supabase ---
# SUPABASE_URL is public (it appears in the frontend too) and is what the
# backend uses to locate the project's public JWKS and check a token's issuer.
#
# The service-role key bypasses Row Level Security. It belongs to the server and
# nowhere else: never in frontend/, never in a VITE_ variable, never in a URL or
# a log line. Anything prefixed VITE_ is compiled into the browser bundle and is
# public by definition. It is used only for direct Data-API access to the
# network tables; it is NOT used to verify user tokens.
#
# Both values are on the Supabase dashboard under Project Settings > API.
# Fill these in .env (git-ignored), not here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (Supabase JWT verification) ---
# The backend verifies Supabase-issued user tokens as a resource server. This
# project signs with ES256, so verification uses the project's PUBLIC keys
# (fetched from SUPABASE_URL's JWKS) and needs no secret here.
#
# Audience of a signed-in Supabase user. The default is correct for GoTrue.
SUPABASE_JWT_AUD=authenticated
# Only set this if the project still uses the legacy shared HS256 secret.
# Leave empty for ES256/asymmetric projects (the default).
SUPABASE_JWT_SECRET=

# --- Assistant (grounded RAG project assistant) ---
# Generation runs on a LOCAL model via Ollama. There is NO API key here and no
# cloud provider: the GRIDOPT dataset, solver results and documents never leave
# this machine, and the assistant costs nothing per question.
#
# Prerequisites, once:
#   1. Install Ollama:  https://ollama.com/download
#   2. Pull the model:  ollama pull llama3.2:3b
#
# Nothing below is a secret - a loopback host and a model name - so these are
# safe to commit and safe to log.
#
# Must be a loopback address. The backend refuses a non-local host outright,
# so the project's data cannot be sent to a remote model by a config change.
# OLLAMA_HOST=http://127.0.0.1:11434
#
# Any model you have pulled. Larger answers better and runs slower; on a
# machine without a dedicated GPU, a 3B model is the sensible default.
# ASSISTANT_MODEL=llama3.2:3b
#
# Context window handed to the model. Must comfortably exceed the grounding
# prompt plus the retrieved context, because Ollama truncates a longer prompt
# silently.
# OLLAMA_NUM_CTX=8192
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_KEEP_ALIVE=10m
#
# Seconds to wait for a local answer. CPU inference is slow and the first
# request also pays the model load.
# ASSISTANT_TIMEOUT_S=180
# ASSISTANT_MAX_TOKENS=800
# ASSISTANT_TOP_K=8
#
# Filename of the built knowledge base, inside OUTPUTS_DIR. Rebuild it with:
#   python reindex_assistant.py
# ASSISTANT_INDEX_FILE=assistant_index.json

# --- IBM Quantum (Phase 2, optional: only for `run_phase2.py --mode ibm`) ---
# Copy this file to .env and paste your key after the '=' on the line below.
# .env is git-ignored; this .env.example must stay empty and is safe to commit.
# Verify the setup without contacting IBM: python run_phase2.py --check-ibm
#
# Required. API key from https://quantum.cloud.ibm.com (your account / API keys).
IBM_QUANTUM_TOKEN=
# Optional. CRN / instance identifier, when your account has more than one.
IBM_QUANTUM_INSTANCE=
# Optional. Channel. Default is ibm_quantum_platform; the retired 'ibm_quantum'
# channel is no longer accepted by qiskit-ibm-runtime.
IBM_QUANTUM_CHANNEL=
# Optional. Pin a device by name; default is the least busy operational one.
IBM_QUANTUM_BACKEND=
